{
  "enabled": true,
  "vanillaButtons": false,
  "applyToAllScreens": true,
  "background": {
    "type": "image",
    "file": "background.png",
    "fit": "cover",
    "opacity": 1.0,
    "extraLoadingScreens": [
      "com.example.mymod.MyLoadingScreen"
    ]
  },
  "mark": {
    "file": "logo_wide_white.png",
    "width": 420,
    "opacity": 0.9,
    "x": 0.5,
    "y": 0.5,
    "onMainMenu": false
  },
  "bootLog": {
    "enabled": true,
    "builtin": "ubuntu",
    "spinner": [
      "A start job is running for Hold until boot process finishes up",
      "[  OK  ] Reached target Cloud-init target"
    ],
    "spacingMs": 95,
    "scale": 1.0,
    "x": 0.02,
    "y": 0.04,
    "align": "left",
    "valign": "top",
    "meter": "systemd",
    "spinnerWidth": 12,
    "onAllScreens": true
  },
  "theme": {
    "buttonStyle": "solid",
    "backdrop": "#66000000",
    "buttonBackdrop": "#1A000000",
    "buttonFill": "#B0121216",
    "buttonFillHover": "#D01E1E26",
    "buttonBorder": "#FF3C3C46",
    "buttonBorderHover": "#FF4FD1E0",
    "buttonText": "#FFE6E6EE",
    "buttonTextHover": "#FFFFFFFF",
    "accent": "#FF4FD1E0",
    "labelText": "#FFCFCFD8"
  },
  "elements": [
    {
      "type": "column",
      "x": 0.04,
      "y": 0.5,
      "align": "left",
      "valign": "middle",
      "width": 300,
      "gap": 6,
      "childAlign": "left",
      "children": [
        {
          "type": "image",
          "file": "logo_wide_intro_white.png",
          "width": 300,
          "animation": {
            "cols": 8,
            "rows": 10,
            "frameMs": 33,
            "loop": false
          }
        },
        {
          "type": "label",
          "text": "ccnr_menu.example.subtitle",
          "scale": 1.0,
          "color": "#FF9FB4C7"
        },
        {
          "type": "button",
          "text": "进入服务器",
          "action": "connect:play.example.com",
          "width": 200,
          "height": 20
        },
        {
          "type": "button",
          "text": "单人游戏",
          "action": "screen:singleplayer",
          "width": 200,
          "height": 20
        },
        {
          "type": "button",
          "text": "设置",
          "action": "screen:options",
          "width": 200,
          "height": 20
        },
        {
          "type": "button",
          "text": "退出游戏",
          "action": "quit",
          "width": 200,
          "height": 20
        }
      ]
    }
  ]
}
